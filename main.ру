import asyncio
import os
from aiohttp import web
from aiogram import Bot, Dispatcher
from config import BOT_TOKEN
from database import init_db
from handlers import start, profile, jobs, transfers, admin, property, education, top, business, events, checkup, common, social, faq
from tasks.scheduler import start_scheduler

async def health(request): return web.Response(text="OK")

async def start_web_server():
    app = web.Application()
    app.router.add_get("/", health)
    app.router.add_get("/health", health)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 8080))
    site = web.TCPSite(runner, "0.0.0.0", port)
    await site.start()

async def main():
    await init_db()
    bot = Bot(token=BOT_TOKEN)
    dp = Dispatcher()

    for router_module in [start, profile, jobs, transfers, admin, property, education, top, business, events, checkup, common, social, faq]:
        dp.include_router(router_module.router)

    start_scheduler()
    await start_web_server()
    print("Бот Пихта запущен (Этап 3.5)...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
