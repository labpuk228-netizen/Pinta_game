import asyncio, os
from aiohttp import web
from aiogram import Bot, Dispatcher
from config import BOT_TOKEN
from database import init_db
from handlers import start, common, profile, jobs, education, property, business, mining, market, casino, social, crime
from tasks.scheduler import start_scheduler

async def health(request): return web.Response(text="OK")

async def start_web_server():
    app = web.Application()
    app.router.add_get("/", health)
    app.router.add_get("/health", health)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 8080))
    await web.TCPSite(runner, "0.0.0.0", port).start()

async def main():
    await init_db()
    bot = Bot(token=BOT_TOKEN)
    dp = Dispatcher()

    for r in [start, common, profile, jobs, education, property, business, mining, market, casino, social, crime]:
        dp.include_router(r.router)

    start_scheduler()
    await start_web_server()
    print("Бот Пихта запущен (Блок 4 - Криминал и Сезоны)...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
